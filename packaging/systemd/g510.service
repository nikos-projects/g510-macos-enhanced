# The G510 agent, as a systemd user unit.
#
# A user unit rather than a system one, deliberately. The daemon types into a
# session, launches applications and reads the media player, all of which are
# things that belong to a logged-in user and none of which a root service can
# do without reaching across the session boundary. It needs no privileges
# beyond what the udev rules grant to the device nodes.
#
#   systemctl --user enable --now g510.service
#   systemctl --user status g510.service
#   journalctl --user -u g510.service -f

[Unit]
Description=Logitech G510 keyboard agent
Documentation=file:///usr/share/doc/g510-linux/README.md

# There is deliberately no Requires=/BindsTo= on a .device unit here. The
# daemon treats a missing keyboard as an ordinary state: it waits, and picks
# the device up when it appears. Tying the service to a device unit would
# instead leave it not-started on every boot where the keyboard was unplugged,
# and it would not come back by itself on a machine where the hotplug event
# arrives before the user session does.
[Service]
Type=simple
ExecStart=/usr/bin/g510 run

# Restart if it falls over, but not if it exits cleanly - a clean exit is what
# `g510 stop` and a deliberate shutdown look like, and restarting then would
# fight the user. RestartSec keeps a persistent failure from spinning.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
